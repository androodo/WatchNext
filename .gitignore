# Data (never commit MovieLens dumps)
data/raw/
data/processed/*
!data/processed/.gitkeep
!data/processed/items.parquet
!data/processed/item_categories.json
!data/processed/imdb_movies.parquet
!data/processed/imdb_movies.json

# Model artifacts — keep the trained demo models in git so Render can build
artifacts/*
!artifacts/.gitkeep
!artifacts/als.npz
!artifacts/als.json
!artifacts/popularity.parquet
!artifacts/ranker-v1.txt
!artifacts/ranker-v1.json
!artifacts/training_summary.json

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Go
bin/
*.exe
*.test
*.out
vendor/

# Node
web/node_modules/
web/.next/
web/out/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# Env / secrets
.env
.env.local
*.pem

# Reports generated locally may be committed; keep placeholders
reports/.cache/

# Temp
tmp/
*.log
