{
  "title": "PulseRank",
  "uid": "pulserank",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Request latency",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(pulserank_request_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fallbacks",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(pulserank_fallback_total[1m])) by (reason)",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Feature freshness",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(pulserank_feature_freshness_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 freshness"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Events processed",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "sum(rate(pulserank_events_processed_total[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
